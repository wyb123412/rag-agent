# ============ LLM（对话模型）：DeepSeek 官方 ============
# 注册/登录 https://platform.deepseek.com 创建 API Key
LLM_API_KEY=sk-你的deepseek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ============ Embedding（向量化）：硅基流动 SiliconFlow ============
# 注册 https://cloud.siliconflow.cn 创建 API Key（BAAI/bge-m3 中文好、有免费额度）
EMBED_API_KEY=sk-你的硅基流动密钥
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# ============ 重排序（Rerank）：硅基流动 ============
# 留空 RERANK_API_KEY 会自动复用 EMBED_API_KEY
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============ 混合检索 ============
RRF_K=60

# ============ 可选：LLM 和 Embedding 都用硅基流动（只填一个 key）============
# 若想这样，把上面的 LLM_BASE_URL 改成 https://api.siliconflow.cn/v1、
# LLM_MODEL 改成 deepseek-ai/DeepSeek-V3，并把 EMBED_API_KEY 留空（会自动复用 LLM_API_KEY）。

# ============ 切片 / 检索参数（可不填，用默认值）============
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# ============ 查询改写（可选，默认 none）============
# none=不改写；hyde=假设文档；multi=多 Query
QUERY_REWRITE=none

# ============ 图片 OCR（可选）============
# 入库时对图片（jpg/png 等）提取文字用的视觉模型（走硅基流动，复用 EMBED_API_KEY）
# 默认 Qwen3-VL-8B 直接输出纯文本；需要更强表格识别可改 deepseek-ai/DeepSeek-OCR
OCR_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ============ 知识图谱（可选）============
# graph_build.py 生成的图谱文件路径
GRAPH_PATH=data/graph.json

# ============ 切片模式（可选）============
# semantic=按标题语义切片（默认，块自带标题上下文）；fixed=固定大小切片
CHUNK_MODE=semantic

# ============ Corrective RAG（可选，默认开）============
# 检索后做相关性自检，不相关则改写查询重检索（1=开，0=关）
CORRECTIVE_RAG=1

# ============ RAPTOR 分层索引（可选）============
# ingest.py --raptor 时对相似切片聚类并生成摘要块，支撑全局性问题
# 聚类相似度阈值（0~1，越大簇越紧、摘要块越少）
RAPTOR_SIM_THRESHOLD=0.6
